/**
 * app.wxss - 全局设计系统
 * 风格：温暖的新本地化社区感（Warm Neighborhood）
 * 主色：暖橙红 + 米白 + 深墨
 */

/* ========== 设计令牌（CSS 变量） ========== */
page {
  /* 色彩 */
  --color-primary: #E8533F;        /* 暖橙红 - 主品牌色 */
  --color-primary-soft: #F4A78F;   /* 浅橙 */
  --color-primary-deep: #C13825;   /* 深橙红 */
  --color-warm-bg: #FAF6F1;        /* 米白背景 */
  --color-paper: #FFFFFF;          /* 卡片白 */
  --color-ink: #1A1A1A;            /* 深墨文字 */
  --color-ink-2: #4A4A4A;          /* 次级文字 */
  --color-ink-3: #8A8A8A;          /* 辅助文字 */
  --color-line: #EDE6DC;           /* 分割线 */
  --color-accent: #C8A24C;         /* 古铜金 - 装饰 */
  --color-success: #4A9F6A;
  --color-warn: #E0853F;
  --color-error: #C24A4A;

  /* 字体 */
  --font-serif: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
  --font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;

  /* 圆角与阴影 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --shadow-1: 0 2rpx 8rpx rgba(26, 26, 26, 0.04);
  --shadow-2: 0 8rpx 24rpx rgba(26, 26, 26, 0.06);
  --shadow-3: 0 16rpx 40rpx rgba(26, 26, 26, 0.08);

  background: var(--color-warm-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-size: 28rpx;
  line-height: 1.5;
}

/* ========== 通用容器 ========== */
.container { padding: 32rpx; }
.container-tight { padding: 16rpx 32rpx; }

/* ========== 字体 ========== */
.font-serif { font-family: var(--font-serif); }
.font-12 { font-size: 24rpx; }
.font-13 { font-size: 26rpx; }
.font-14 { font-size: 28rpx; }
.font-16 { font-size: 32rpx; }
.font-18 { font-size: 36rpx; }
.font-20 { font-size: 40rpx; }
.font-24 { font-size: 48rpx; }
.font-28 { font-size: 56rpx; }

.color-ink { color: var(--color-ink); }
.color-ink-2 { color: var(--color-ink-2); }
.color-ink-3 { color: var(--color-ink-3); }
.color-primary { color: var(--color-primary); }
.color-accent { color: var(--color-accent); }

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }

/* ========== 卡片 ========== */
.card {
  background: var(--color-paper);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-1);
}
.card-tight { padding: 20rpx 24rpx; }

/* ========== 按钮 ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
  letter-spacing: 1rpx;
}
.btn::after { border: none; }

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(232, 83, 63, 0.3);
}
.btn-primary:active { background: var(--color-primary-deep); transform: translateY(1rpx); }

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-ghost {
  background: var(--color-warm-bg);
  color: var(--color-ink);
}

.btn-block { display: flex; width: 100%; }
.btn-sm { padding: 12rpx 32rpx; font-size: 26rpx; }

/* ========== 标签 / 徽章 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(232, 83, 63, 0.08);
  color: var(--color-primary);
  font-weight: 500;
}
.tag-ghost { background: rgba(0, 0, 0, 0.04); color: var(--color-ink-2); }
.tag-accent { background: rgba(200, 162, 76, 0.12); color: var(--color-accent); }
.tag-success { background: rgba(74, 159, 106, 0.12); color: var(--color-success); }
.tag-warn { background: rgba(192, 74, 74, 0.1); color: var(--color-error); }

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--color-line);
  margin: 24rpx 0;
}

/* ========== 通用 flex 工具 ========== */
.row { display: flex; flex-direction: row; align-items: center; }
.row-between { display: flex; justify-content: space-between; align-items: center; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.gap-24 { gap: 24rpx; }

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  color: var(--color-ink-3);
}
.empty-emoji { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; margin-bottom: 12rpx; color: var(--color-ink-2); }
.empty-hint { font-size: 24rpx; color: var(--color-ink-3); }

/* ========== 安全区底部 ========== */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
