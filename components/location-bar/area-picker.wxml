<view class="picker-mask" bindtap="onClose">
  <view class="picker-sheet" catchtap="">
    <!-- 顶部:返回/标题 -->
    <view class="picker-header">
      <view wx:if="{{!cityAdcode}}" class="picker-title">选择城市</view>
      <view wx:else class="picker-tabs">
        <view class="picker-tab {{tab === 'area' ? 'active' : ''}}" data-tab="area" bindtap="switchTab">区/县</view>
        <view class="picker-tab {{tab === 'street' ? 'active' : ''}}" data-tab="street" bindtap="switchTab">镇/街道</view>
      </view>
    </view>

    <!-- 搜索框 -->
    <view class="picker-search">
      <input
        class="picker-search-input"
        placeholder="{{cityAdcode ? '搜索区/县' : '搜索城市'}}"
        placeholder-class="placeholder"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
      />
      <view wx:if="{{keyword}}" class="picker-search-clear" bindtap="onClearKeyword">×</view>
    </view>

    <view wx:if="{{error}}" class="picker-error">{{error}}</view>

    <!-- 区/城市列表 -->
    <scroll-view scroll-y class="picker-list">
      <block wx:if="{{tab === 'area'}}">
        <view
          wx:for="{{items}}"
          wx:key="area_adcode"
          class="picker-item {{item.area_adcode === areaAdcode ? 'selected' : ''}}"
          data-item="{{item}}"
          bindtap="onSelectItem">
          <view class="picker-item-tag" wx:if="{{item.area_adcode === areaAdcode}}"></view>
          <view class="picker-item-main">
            <text class="picker-item-name">{{item.area_name}}</text>
            <text wx:if="{{!cityAdcode && item.city_name}}" class="picker-item-sub">{{item.city_name}}</text>
          </view>
          <text class="picker-item-count">{{item.post_count + item.shop_count}}</text>
        </view>
        <view wx:if="{{!loading && items.length === 0}}" class="picker-empty">
          {{cityAdcode ? '暂无区数据' : '暂无城市数据'}}
        </view>
      </block>
      <block wx:else>
        <view
          wx:for="{{streets}}"
          wx:key="street_name"
          class="picker-item"
          data-item="{{item}}"
          bindtap="onSelectStreet">
          <text class="picker-item-name">{{item.street_name}}</text>
          <text class="picker-item-count">{{item.post_count + item.shop_count}}</text>
        </view>
        <view wx:if="{{!loading && streets.length === 0}}" class="picker-empty">暂无街道数据</view>
      </block>
    </scroll-view>
  </view>
</view>