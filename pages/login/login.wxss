/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: var(--color-warm-bg);
  position: relative;
  overflow: hidden;
}

/* ===== 顶部 hero 区 ===== */
.hero {
  position: relative;
  height: 520rpx;
  background: linear-gradient(135deg, #F4A78F 0%, #E8533F 60%, #C13825 100%);
  overflow: hidden;
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.hero-circle-1 {
  width: 320rpx; height: 320rpx;
  top: -120rpx; right: -80rpx;
}
.hero-circle-2 {
  width: 180rpx; height: 180rpx;
  top: 280rpx; left: -60rpx;
  background: rgba(255, 255, 255, 0.08);
}
.hero-circle-3 {
  width: 96rpx; height: 96rpx;
  top: 200rpx; right: 80rpx;
  background: rgba(255, 255, 255, 0.15);
}

.brand {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.brand-mark, .brand-mark-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
}
.brand-mark {
  color: var(--color-primary);
  font-family: var(--font-serif);
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.brand-slogan {
  font-size: 26rpx;
  opacity: 0.92;
  letter-spacing: 2rpx;
}

/* ===== 主体 ===== */
.body {
  position: relative;
  margin-top: -48rpx;
  background: var(--color-warm-bg);
  border-radius: 48rpx 48rpx 0 0;
  padding: 64rpx 48rpx 80rpx;
}

.welcome {
  margin-bottom: 56rpx;
}
.welcome-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-ink);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}
.welcome-desc {
  font-size: 28rpx;
  color: var(--color-ink-2);
  line-height: 1.6;
}

/* ===== 特色 4 宫格 ===== */
.features {
  display: flex;
  justify-content: space-between;
  background: var(--color-paper);
  border-radius: var(--radius-lg);
  padding: 32rpx 16rpx;
  box-shadow: var(--shadow-1);
  margin-bottom: 64rpx;
}

.feature {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.feature-emoji {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.feature-name {
  font-size: 26rpx;
  color: var(--color-ink-2);
}

/* ===== 协议 ===== */
.agreement {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-left: 8rpx;
}
.agree-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-ink-3);
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  transition: all 0.2s;
}
.agree-check.is-checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.agree-check-inner {
  width: 12rpx;
  height: 6rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(2rpx, -2rpx);
}
.agree-text {
  font-size: 24rpx;
  color: var(--color-ink-3);
}
.agree-link {
  color: var(--color-primary);
}

/* ===== 按钮 ===== */
.login-btn {
  height: 96rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}
.btn-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.footer-hint {
  text-align: center;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--color-ink-3);
  letter-spacing: 1rpx;
}
