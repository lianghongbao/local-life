/* pages/mine/mine.wxss */
.mine {
  padding-bottom: 80rpx;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  padding: 80rpx 24rpx 96rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #F4A78F 0%, #E8533F 60%, #C13825 100%);
  z-index: 0;
}
.hero-bg::before, .hero-bg::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.hero-bg::before {
  width: 280rpx; height: 280rpx;
  top: -100rpx; right: -80rpx;
}
.hero-bg::after {
  width: 160rpx; height: 160rpx;
  bottom: 60rpx; left: -40rpx;
  background: rgba(255, 255, 255, 0.06);
}

.user-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);   /* 浅兜底,图片加载失败时圆圈不至于透明 */
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-fallback, .avatar-empty {
  color: #fff;
  font-size: 56rpx;
  font-family: var(--font-serif);
  font-weight: 700;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 默认 logo (兜底图) —— 满铺填满圆圈,不再加 padding/背景,避免"白底方块浮在圆中间" */
.avatar-empty-img {
  display: block;
  width: 100%;
  height: 100%;
}

.cat-placeholder {
  display: block;
  width: 100%;
  height: 100%;
}
.avatar-empty {
  background: rgba(255, 255, 255, 0.15);
}

.user-info {
  flex: 1;
  color: #fff;
  min-width: 0;
}
.user-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}
.user-hint {
  font-size: 24rpx;
  opacity: 0.85;
}

.user-status {
  flex-shrink: 0;
}

/* ===== 头像/昵称点击编辑 ===== */
.avatar-hover {
  opacity: 0.75;
  transform: scale(0.96);
}

.user-info-hover {
  opacity: 0.85;
}

.user-edit-hint {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

/* ===== 入口网格 ===== */
.entry-grid {
  margin: -48rpx 32rpx 24rpx;
  padding: 32rpx 0;
  display: flex;
  position: relative;
  z-index: 2;
}
.entry-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.entry-emoji {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.entry-name {
  font-size: 26rpx;
  color: var(--color-ink);
}

/* ===== 菜单 ===== */
.menu {
  margin: 0 24rpx 32rpx;
  padding: 0 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-emoji {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-ink);
}
.menu-arrow {
  color: var(--color-ink-3);
  font-size: 32rpx;
}

/* ===== 退出登录(独立 card,弱化文字,无 emoji/箭头) ===== */
.logout-card {
  margin: 0 32rpx 32rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: opacity 0.15s ease;
}
.logout-card:active {
  opacity: 0.6;
}
.logout-text {
  font-size: 28rpx;
  color: var(--color-ink-3);   /* 弱化色,避免刺眼 */
  letter-spacing: 2rpx;
}

.footer-safe { height: 32rpx; }
