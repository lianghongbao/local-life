/* pages/my-posts/my-posts.wxss */
.my-posts {
  padding: 24rpx 32rpx;
  min-height: 100vh;
}

.list { }

.post-card {
  display: flex;
  background: var(--color-paper);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-1);
}
.post-cover-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #F0E8DC;
}
.post-cover { width: 100%; height: 100%; }
.post-body {
  flex: 1;
  padding: 20rpx 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}
.post-status {
  margin-left: 12rpx;
  font-size: 22rpx;
}

/* 状态胶囊: 紧贴类型, 与详情页保持一致风格 */
.post-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
}
.post-status-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}
.post-status-pill.audit { background: rgba(200, 162, 76, 0.12); color: #B68A2D; }
.post-status-pill.offline { background: rgba(153, 153, 153, 0.14); color: #6F6A60; }
.post-status-pill.rejected { background: rgba(194, 74, 74, 0.10); color: #A53B3B; }
.post-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-content {
  font-size: 26rpx;
  color: var(--color-ink-2);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.post-address {
  font-size: 26rpx;
  color: var(--color-ink-2);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.post-meta {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: var(--color-ink-3);
}
.post-contact {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--color-ink-3);
  font-size: 22rpx;
}
.post-edit {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-primary);
}
.post-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.loading {
  text-align: center;
  padding: 32rpx 0;
  color: var(--color-ink-3);
  font-size: 24rpx;
}
