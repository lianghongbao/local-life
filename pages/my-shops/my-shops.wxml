<!--pages/my-shops/my-shops.wxml-->
<view class="my-shops">
  <view wx:if="{{list.length === 0 && !loading}}" class="empty">
    <view class="empty-emoji">🏪</view>
    <view class="empty-text">还没有收录过本地小店</view>
    <view class="empty-hint">去本地页分享一条吧</view>
  </view>

  <view class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="shop-card"
      data-id="{{item.id}}"
      bindtap="onItemTap">
      <view wx:if="{{item.cover}}" class="shop-cover-wrap">
        <image class="shop-cover" src="{{item.cover}}" mode="aspectFill" />
      </view>
      <view class="shop-body">
        <view class="shop-head">
          <view class="shop-cat tag">{{item.catEmoji}} {{item.catName}}</view>
          <view class="shop-status" style="color:{{item.statusInfo.color}}">
            ·{{item.statusInfo.name}}·
          </view>
          <view class="shop-edit" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
        </view>
        <view class="shop-name font-serif">{{item.name}}</view>
        <view class="shop-address">📍 {{item.address}}</view>
        <view class="shop-meta">
          <text class="shop-phone">📞 {{item.phone}}</text>
          <text class="shop-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:elif="{{finished && list.length > 0}}" class="loading">— 已经到底了 —</view>
  </view>
</view>
