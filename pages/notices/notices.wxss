/* pages/notices/notices.wxss */
.notices {
  padding: 24rpx 32rpx;
  min-height: 100vh;
}

.notice-card {
  background: var(--color-paper);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
  position: relative;
  overflow: hidden;
}
.notice-pin {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--color-accent);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx 6rpx 24rpx;
  border-radius: 0 0 0 16rpx;
}
.notice-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
  line-height: 1.4;
  padding-right: 80rpx;
}
.notice-time {
  font-size: 22rpx;
  color: var(--color-ink-3);
}

.loading {
  text-align: center;
  padding: 32rpx 0;
  color: var(--color-ink-3);
  font-size: 24rpx;
}
