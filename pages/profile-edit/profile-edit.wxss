/* pages/profile-edit/profile-edit.wxss */
.edit-page {
  min-height: 100vh;
  background: #fff8f0;
  padding: 32rpx 24rpx 0;
}

.hero.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 159, 122, 0.08);
}

.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 48rpx;
  border-bottom: 1rpx solid #f5e6d3;
  margin-bottom: 48rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #ffe4d2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  font-size: 64rpx;
  font-weight: 600;
  color: #d97e4a;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-placeholder {
  width: 100%;
  height: 100%;
}

.avatar-btn {
  min-width: 240rpx;
}

.field {
  padding: 0 8rpx;
}

.field-label {
  font-size: 28rpx;
  color: #8b6f47;
  margin-bottom: 16rpx;
}

.field-input {
  background: #fff8f0;
  border: 2rpx solid #f5e6d3;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #2d2d2d;
}

.field-input[disabled] {
  background: #f5f5f5;
  color: #999;
}

.field-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b8a080;
  text-align: right;
}

.actions {
  padding: 48rpx 24rpx 0;
}

.save-btn {
  height: 96rpx;
  font-size: 32rpx;
}

.save-btn[disabled] {
  background: #d4c5a8;
  color: #fff;
  opacity: 0.6;
}

.footer-hint {
  text-align: center;
  font-size: 24rpx;
  color: #b8a080;
  margin-top: 24rpx;
}

.footer-safe {
  height: env(safe-area-inset-bottom);
}