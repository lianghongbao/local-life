<!--pages/shop-create/shop-create.wxml-->
<view class="shop-create">
  <!-- ===== 强制定位:GPS 进行中(用户点了 📍 之后才显示) ===== -->
  <view wx:if="{{locating}}" class="locating-overlay">
    <view class="locating-spinner"></view>
    <view class="locating-text">正在获取位置...</view>
    <view class="locating-hint">请允许位置权限</view>
  </view>

  <!-- ===== 强制定位:地图选点中 ===== -->
  <view wx:elif="{{locatingForPicking}}" class="locating-overlay">
    <view class="locating-spinner"></view>
    <view class="locating-text">请在地图上选择你的位置</view>
    <view class="locating-hint">需要先选好位置再提交</view>
  </view>

  <!-- ===== 表单:进页就显示,地址未点过时 address 是空的 ===== -->
  <block wx:else>
    <view class="card section">
      <view class="section-title">类目</view>
      <view class="cat-grid">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="cat-pill {{form.category === item.id ? 'is-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCategorySelect">
          <text class="cat-emoji">{{item.emoji}}</text>
          <text class="cat-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="card section">
      <view class="section-title">名称</view>
      <input class="input" placeholder="如：张师傅开锁" placeholder-class="placeholder" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="50" />
    </view>

    <view class="card section">
      <view class="section-title">联系电话</view>
      <input class="input" type="number" placeholder="11 位手机号" placeholder-class="placeholder" value="{{form.phone}}" data-field="phone" bindinput="onInput" maxlength="20" />
    </view>

    <view class="card section">
      <view class="form-row">
        <view class="section-title">📍 地址 <text class="required-mark">*</text></view>
        <view class="address-row">
          <input
            class="input address-input"
            placeholder=" "
            placeholder-class="placeholder"
            value="{{form.address}}"
            data-field="address"
            bindinput="onAddressInput"
            bindfocus="onAddressFocus"
            maxlength="100" />
          <view class="address-map-btn" bindtap="onChooseLocation">📍</view>
        </view>
        <view wx:if="{{locationFailed}}" class="address-tip-warn">⚠️ 定位被拒绝，点击输入框重新授权</view>
        <view wx:else class="address-tip">点击输入框选择位置（必填）</view>
      </view>
    </view>

  <view class="card section">
    <view class="section-title">简介</view>
    <textarea class="textarea" placeholder="服务特色、营业时间等" placeholder-class="placeholder" value="{{form.description}}" data-field="description" bindinput="onInput" maxlength="300" auto-height />
  </view>

  <view class="card section">
    <view class="section-title">门头 / 店内照 <text class="section-tip">最多 6 张 · 仅 jpg/png · 单张 ≤ 10MB</text></view>
    <view class="image-grid">
      <view
        wx:for="{{form.images}}"
        wx:key="fileKey"
        class="image-item">
        <image class="image-thumb" src="{{item.url}}" mode="aspectFill" data-idx="{{index}}" bindtap="onPreview" />
        <view class="image-remove" data-idx="{{index}}" bindtap="onRemoveImage">×</view>
      </view>
      <view wx:if="{{form.images.length < 6}}" class="image-add" bindtap="onChooseImage">
        <view class="image-add-plus">+</view>
        <view class="image-add-text">添加图片</view>
      </view>
    </view>
  </view>

  <view class="submit-area safe-bottom">
    <button
      class="btn btn-primary btn-block submit-btn {{submitting ? 'is-loading' : ''}}"
      bindtap="onSubmit"
      disabled="{{submitting}}">
      {{submitting ? '提交中...' : (isEdit ? '保存修改' : '提交收录')}}
    </button>
    <view class="submit-tip">{{isEdit ? '修改后需重新审核' : '审核通过后会收录展示，1 个工作日内反馈'}}</view>
  </view>
  </block>
</view>
