/* pages/shop-detail/shop-detail.wxss */
.detail {
  padding-bottom: 200rpx;
}

/* ===== 骨架屏 ===== */
@keyframes skel-shimmer {
  0% { background-position: -400rpx 0 }
  100% { background-position: 400rpx 0 }
}
.skel-cover {
  height: 480rpx;
  background: linear-gradient(90deg, #F0E8DC 25%, #F8F1E2 50%, #F0E8DC 75%);
  background-size: 800rpx 100%;
  animation: skel-shimmer 1.5s infinite linear;
}
.skel-card-overlap {
  margin: -64rpx 32rpx 0;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, #F0E8DC 25%, #F8F1E2 50%, #F0E8DC 75%);
  background-size: 800rpx 100%;
  animation: skel-shimmer 1.5s infinite linear;
  position: relative;
  z-index: 2;
}
.skel-card {
  margin: 32rpx 32rpx 0;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, #F0E8DC 25%, #F8F1E2 50%, #F0E8DC 75%);
  background-size: 800rpx 100%;
  animation: skel-shimmer 1.5s infinite linear;
}

/* ===== 封面 ===== */
.cover-wrap {
  width: 100%;
  height: 480rpx;
  overflow: hidden;
  margin-bottom: -64rpx;
  position: relative;
}
.cover {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--color-primary-soft) 0%, var(--color-primary) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-placeholder-emoji {
  font-size: 200rpx;
  opacity: 0.6;
}
.cover-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.15));
}

/* ===== 主卡 ===== */
.main-card {
  position: relative;
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  z-index: 2;
  box-shadow: var(--shadow-2);
}
.shop-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 2rpx;
  line-height: 1.3;
  margin-bottom: 24rpx;
}

/* ===== 统计行 ===== */
.stats-row {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-line);
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-ink-3);
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-line);
}

/* ===== 通用卡片 ===== */
.card {
  margin: 0 32rpx 24rpx;
  background: var(--color-paper);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-1);
}

/* ===== Section Header（首页风格） ===== */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-tag-bar {
  width: 8rpx;
  height: 32rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
  margin-right: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 2rpx;
}

.description {
  font-size: 28rpx;
  color: var(--color-ink-2);
  line-height: 1.8;
}

/* ===== 相册 ===== */
.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  overflow: hidden;
}
.gallery-item-wrap {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
}
.gallery-item {
  width: 100%;
  height: 200rpx;
  display: block;
  border-radius: var(--radius-md);
  background: #F0E8DC;
  box-shadow: var(--shadow-1);
}
.gallery-more {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
/* 地址行可点击打开地图 — 用 hover-class 给视觉反馈 */
.info-row-active {
  opacity: 0.6;
  background: rgba(232, 83, 63, 0.04);
  border-radius: 8rpx;
  transition: all 0.15s ease;
}
.info-icon-wrap {
  font-size: 36rpx;
  width: 60rpx;
  text-align: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.info-body {
  flex: 1;
  min-width: 0;
}
.info-label {
  font-size: 22rpx;
  color: var(--color-ink-3);
  margin-bottom: 4rpx;
}
.info-value {
  font-size: 28rpx;
  color: var(--color-ink);
}
.info-action {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-paper);
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}
.call-btn {
  height: 96rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.shop-address {
  font-size: 26rpx;
  color: var(--color-ink-2);
  margin-bottom: 16rpx;
}

/* 整个地图卡片可点击 */
.map-tap {
  cursor: pointer;
  position: relative;
}
.map-tap-active {
  background: rgba(232, 83, 63, 0.04);
  transition: all 0.15s ease;
}
.map-hint {
  font-size: 22rpx;
  color: var(--color-primary);
  opacity: 0.75;
  margin-left: auto;
  flex-shrink: 0;
}
.shop-map {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
}
.footer-safe { height: 32rpx; }

/* ===== 地图预览（与 post-detail 共用同一套样式） =====
   腾讯静态图 API 真实地图缩略图 + 暖色遮罩,避开 <map> 原生组件拦截 touchmove。
   真实导航通过 onOpenMap → wx.openLocation 跳微信原生地图。 */
.map-preview {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: linear-gradient(135deg, #F8F1E2 0%, #F0E8DC 100%);
  box-shadow: inset 0 0 0 1rpx rgba(232, 83, 63, 0.08);
}
.map-preview-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.map-preview-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(250, 246, 241, 0.55) 0%,
    rgba(240, 232, 220, 0.25) 50%,
    rgba(232, 83, 63, 0.08) 100%
  );
  pointer-events: none;
}
.map-preview-pin {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}
.pin-icon {
  font-size: 56rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 6rpx rgba(232, 83, 63, 0.35));
  margin-bottom: 6rpx;
}
.pin-label {
  font-size: 22rpx;
  color: var(--color-ink-2);
  background: rgba(255, 255, 255, 0.9);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-1);
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
